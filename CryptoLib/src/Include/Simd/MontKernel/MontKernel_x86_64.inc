  mov  rcx, rdx
  mov  rax, [r9 + 32]
  mul  rbx
  add  rax, rcx
  adc  rdx, 0
  add  rax, r12
  adc  rdx, 0
  mov  r11, rax
  mov  rcx, rdx
  mov  rax, [r9 + 40]
  mul  rbx
  add  rax, rcx
  adc  rdx, 0
  add  rax, r13
  adc  rdx, 0
  mov  r12, rax
  mov  rcx, rdx
