  mov  rcx, rdx
  mov  rax, [rsi + 8]
  mul  rbx
  add  rax, rcx
  adc  rdx, 0
  add  rax, r11
  adc  rdx, 0
  mov  r11, rax
  mov  rcx, rdx
  mov  rax, [rsi + 16]
  mul  rbx
  add  rax, rcx
  adc  rdx, 0
  add  rax, r12
  adc  rdx, 0
  mov  r12, rax
  mov  rcx, rdx
  mov  rax, [rsi + 24]
  mul  rbx
  add  rax, rcx
  adc  rdx, 0
  add  rax, r13
  adc  rdx, 0
  mov  r13, rax
  mov  rcx, rdx
  add  r14, rcx
  mov  r15, 0
  adc  r15, 0
  mov  rbx, [r9]
  imul rbx, r10
  mov  rax, [r9 + 16]
  mul  rbx
  add  rax, r10
  adc  rdx, 0
  mov  rcx, rdx
  mov  rax, [r9 + 24]
  mul  rbx
  add  rax, rcx
  adc  rdx, 0
  add  rax, r11
  adc  rdx, 0
  mov  r10, rax
  mov  rcx, rdx
  mov  rax, [r9 + 32]
  mul  rbx
  add  rax, rcx
  adc  rdx, 0
  add  rax, r12
  adc  rdx, 0
  mov  r11, rax
  mov  rcx, rdx
  mov  rax, [r9 + 40]
  mul  rbx
  add  rax, rcx
  adc  rdx, 0
  add  rax, r13
  adc  rdx, 0
  mov  r12, rax
  mov  rcx, rdx
  add  r14, rcx
  mov  r13, r14
  mov  rax, 0
  adc  rax, 0
  add  r15, rax
  mov  r14, r15
  // constant-time final reduce (register-resident): t in r10..r14, subtract p
  mov  rax, r10
  sub  rax, [r9 + 16]
  mov  rbx, rax
  mov  rax, r11
  sbb  rax, [r9 + 24]
  mov  rsi, rax
  mov  rax, r12
  sbb  rax, [r9 + 32]
  mov  rbp, rax
  mov  rax, r13
  sbb  rax, [r9 + 40]
  mov  r8, rax
  mov  rax, r14
  sbb  rax, 0
  sbb  rdx, rdx          // mask = all-ones if t < p (keep t)
  mov  rcx, rdx
  not  rdx
  and  r10, rcx
  and  rbx, rdx
  or   r10, rbx
  and  r11, rcx
  and  rsi, rdx
  or   r11, rsi
  and  r12, rcx
  and  rbp, rdx
  or   r12, rbp
  and  r13, rcx
  and  r8, rdx
  or   r13, r8
  mov  [rdi + 0], r10
  mov  [rdi + 8], r11
  mov  [rdi + 16], r12
  mov  [rdi + 24], r13
  jmp  @@FpMontDone
@@FpMontGeneral:
  // ---- width-general loop (any N; used by P-384/P-521 and future widths) ----
  lea  r8, [r15 + 2]     // N+2
  xor  rax, rax
  xor  r13, r13
@@FpMontZero:
  mov  [rdi + r13*8], rax
  inc  r13
  cmp  r13, r8
  jb   @@FpMontZero
  xor  r14, r14          // i
@@FpMontRow:
  mov  r12, [rbp + r14*8] // b[i]
  // multiply row: t[0..N-1] += A * b[i], carry into t[N], t[N+1]
  xor  rcx, rcx          // carry
  xor  r13, r13          // j
@@FpMontMul:
  mov  rax, [rsi + r13*8]
  mul  r12
  add  rax, rcx
  adc  rdx, 0
  add  rax, [rdi + r13*8]
  adc  rdx, 0
  mov  [rdi + r13*8], rax
  mov  rcx, rdx
  inc  r13
  cmp  r13, r15
  jb   @@FpMontMul
  mov  rax, [rdi + r15*8] // t[N]
  add  rax, rcx
  mov  [rdi + r15*8], rax
  lea  rbx, [r15 + 1]
  mov  rax, 0
  adc  rax, 0
  mov  [rdi + rbx*8], rax // t[N+1]
  // reduce row: m = t[0]*n0'; t := (t + m*p) >> 64
  mov  rbx, [r9]          // n0'
  imul rbx, [rdi]         // m
  mov  rax, [r9 + 16]     // p[0]
  mul  rbx
  add  rax, [rdi]
  adc  rdx, 0
  mov  rcx, rdx           // carry (low limb discarded)
  mov  r13, 1
@@FpMontRed:
  mov  rax, [r9 + r13*8 + 16]
  mul  rbx
  add  rax, rcx
  adc  rdx, 0
  add  rax, [rdi + r13*8]
  adc  rdx, 0
  lea  r8, [r13 - 1]
  mov  [rdi + r8*8], rax  // t[j-1]
  mov  rcx, rdx
  inc  r13
  cmp  r13, r15
  jb   @@FpMontRed
  mov  rax, [rdi + r15*8] // t[N]
  add  rax, rcx
  lea  r8, [r15 - 1]
  mov  [rdi + r8*8], rax  // t[N-1]
  mov  rax, 0
  adc  rax, 0
  lea  r8, [r15 + 1]
  mov  rdx, [rdi + r8*8]  // t[N+1]
  add  rax, rdx
  mov  [rdi + r15*8], rax // t[N]
  inc  r14
  cmp  r14, r15
  jb   @@FpMontRow
  // constant-time final reduce: t (< 2p) -= p, add p back if it underflowed
  xor  r8, r8            // borrow
  xor  r13, r13
@@FpMontFSub:
  mov  rax, [rdi + r13*8]
  sub  rax, r8
  sbb  rsi, rsi
  sub  rax, [r9 + r13*8 + 16]
  sbb  rbp, rbp
  mov  [rdi + r13*8], rax
  add  rsi, rbp
  neg  rsi
  mov  r8, rsi
  inc  r13
  cmp  r13, r15
  jb   @@FpMontFSub
  mov  rax, [rdi + r15*8]
  sub  rax, r8
  sbb  rdx, rdx          // mask = all-ones if t < p (add-back needed)
  mov  [rdi + r15*8], rax
  xor  r8, r8            // carry
  xor  r13, r13
@@FpMontFAdd:
  mov  rax, [r9 + r13*8 + 16]
  and  rax, rdx
  add  rax, [rdi + r13*8]
  mov  rcx, 0
  adc  rcx, 0
  add  rax, r8
  adc  rcx, 0
  mov  [rdi + r13*8], rax
  mov  r8, rcx
  inc  r13
  cmp  r13, r15
  jb   @@FpMontFAdd
@@FpMontDone:
  pop  r15
  pop  r14
  pop  r13
  pop  r12
  pop  rbp
  pop  rdi
  pop  rsi
  pop  rbx
